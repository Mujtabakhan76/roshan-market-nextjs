# Ye file copy kar ke .env.local banayen aur apni asal values dalein
# .env.local ko kabhi GitHub par upload NA karein (ye khud-ba-khud .gitignore mein shamil hai)

MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# WhatsApp (Green API ya Ultramsg) — optional, agar na bharein to app WhatsApp bhejے bghair kaam karti rahegi
WHATSAPP_PROVIDER=greenapi
GREENAPI_ID_INSTANCE=
GREENAPI_API_TOKEN=
ULTRAMSG_INSTANCE_ID=
ULTRAMSG_TOKEN=
